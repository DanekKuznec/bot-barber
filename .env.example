# Заполните хотя бы один канал: Telegram, ВКонтакте или оба.
# Расписание у них общее.

# ---------- Telegram ----------
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую — им приходят уведомления о записях
ADMIN_IDS=

# ---------- ВКонтакте ----------
# Ключ доступа сообщества (Управление → Работа с API → Ключи доступа)
VK_TOKEN=
# Числовой id сообщества: для vk.com/club123456 это 123456
VK_GROUP_ID=
# id администраторов ВК через запятую (для vk.com/id987654 это 987654)
VK_ADMIN_IDS=

# Файл базы данных (необязательно)
DB_PATH=bookings.sqlite3
